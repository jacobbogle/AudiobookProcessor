{
  "format_info": {
    "description": "Combined metadata mapping for audiobook formats: MP3 (ID3v2), M4A (MP4/iTunes), M4B (MP4/iTunes)",
    "reference_sources": [
      "https://id3.org/id3v2.3.0",
      "https://id3.org/id3v2.4.0-frames", 
      "https://mutagen.readthedocs.io/en/latest/api/mp4.html",
      "https://picard.musicbrainz.org/docs/mappings/"
    ],
    "last_updated": "2025-10-20"
  },
  "core_metadata": {
    "title": {
      "description": "Individual track/chapter title",
      "audiobook_usage": "Chapter title or track name",
      "mp4_atom": "©nam",
      "id3_frame": "TIT2",
      "data_types": {
        "mp4": "utf8_text",
        "id3": "text_string_with_encoding"
      },
      "mutagen_keys": {
        "mp4": "\\xa9nam",
        "id3": "TIT2"
      }
    },
