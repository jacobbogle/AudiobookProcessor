  "audiobook_specific": {
    "media_kind": {
      "description": "Media type identifier (critical for iTunes audiobook recognition)",
      "audiobook_usage": "Must be set to 2 for audiobooks in iTunes/Music app",
      "mp4_atom": "stik",
      "id3_frame": "none",
      "data_types": {
        "mp4": "integer",
        "id3": "not_supported"
      },
      "mutagen_keys": {
        "mp4": "stik",
        "id3": "none"
      },
      "values": {
        "0": "Movie",
        "1": "Music",
        "2": "Audiobook",
        "6": "Music Video",
        "9": "Short Film",
        "10": "TV Show"
      }
    },
    "gapless_playback": {
      "description": "Indicates gapless album for seamless chapter transitions",
      "audiobook_usage": "Should be set to 1/True for audiobooks",
      "mp4_atom": "pgap",
      "id3_frame": "none",
      "data_types": {
        "mp4": "boolean",
        "id3": "not_supported"
      },
      "mutagen_keys": {
        "mp4": "pgap",
        "id3": "none"
      }
    },
    "content_rating": {
      "description": "Content advisory rating",
      "audiobook_usage": "Content rating (0=None, 1=Explicit, 2=Clean)",
      "mp4_atom": "rtng",
      "id3_frame": "none",
      "data_types": {
        "mp4": "integer",
        "id3": "not_supported"
      },
      "mutagen_keys": {
        "mp4": "rtng",
        "id3": "none"
      },
      "values": {
        "0": "None",
        "1": "Explicit", 
        "2": "Clean"
      }
    },
    "encoded_by": {
      "description": "Encoding tool or person",
      "audiobook_usage": "Software used to create the audiobook",
      "mp4_atom": "©too",
      "id3_frame": "TENC",
